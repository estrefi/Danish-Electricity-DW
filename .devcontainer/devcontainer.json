{
  "name": "danish-electricity-dw",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm", "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install -e '.[dev]' && curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/main/install.sh | sudo sh",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "github.vscode-github-actions"]
    }
  }
}
